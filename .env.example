# eLama (основной прослой для Яндекс.Директ)
ELAMA_API_TOKEN=your_elama_token_here
ELAMA_BASE_URL=https://api.elama.ru

# VK Ads (TARGETING)
VK_ADS_TOKEN=your_vk_ads_token_here
VK_ADS_APP_ID=your_vk_ads_app_id_here

# OpenAI / Claude (для генерации креативов)
OPENAI_API_KEY=your_openai_key_here

# Telegram бот
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ads_agent

# Redis
REDIS_URL=redis://localhost:6379

# Режим
DRY_RUN=true
LOG_LEVEL=INFO
