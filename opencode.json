{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "developer",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "architect": {
      "description": "Проектирует архитектуру рекламного агента",
      "mode": "primary",
      "prompt": ".opencode/agents/architect.md",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "developer": {
      "description": "Разрабатывает код интеграции и бизнес-логики",
      "mode": "primary",
      "prompt": ".opencode/agents/developer.md",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "tester": {
      "description": "Создает тесты и ищет ошибки",
      "mode": "primary",
      "prompt": ".opencode/agents/tester.md",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "reviewer": {
      "description": "Проверяет код, безопасность и рекламные изменения",
      "mode": "primary",
      "prompt": ".opencode/agents/reviewer.md",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
