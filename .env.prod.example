# Пароль PostgreSQL (обязательно)
POSTGRES_PASSWORD=generate-strong-password
POSTGRES_USER=postgres
POSTGRES_DB=ads_agent

# Площадки (можно оставить пустыми — работает режим демо)
ELAMA_API_TOKEN=
VK_ADS_TOKEN=
OPENAI_API_KEY=

# Telegram (для автоотчётов 09:00 и бота)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Домен фронтенда на Vercel (можно несколько через запятую)
ALLOWED_ORIGINS=https://ads-agent.vercel.app,http://localhost:3000

# Безопасность: true = система ничего не меняет на площадках
DRY_RUN=true
